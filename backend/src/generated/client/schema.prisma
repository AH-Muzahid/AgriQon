generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/client"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id         String     @id @default(uuid())
  name       String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  businesses Business[]
}

model Business {
  id                  String               @id @default(uuid())
  organizationId      String
  name                String
  email               String?
  phone               String?
  address             String?
  website             String?
  logo                String?
  taxNumber           String?
  currency            String               @default("BDT")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  accounts            Account[]
  AiLog               AiLog[]
  auditLogs           AuditLog[]
  brands              Brand[]
  organization        Organization         @relation(fields: [organizationId], references: [id])
  categories          Category[]
  customers           Customer[]
  embeddings          Embedding[]
  inventory           Inventory[]
  invoices            Invoice[]
  products            Item[]
  orders              Order[]
  OrderItem           OrderItem[]
  outboxEvents        OutboxEvent[]
  payments            Payment[]
  ProductBatch        ProductBatch[]
  PurchaseItem        PurchaseItem[]
  purchases           PurchaseOrder[]
  Review              Review[]
  stockMovements      StockMovement[]
  stockReservations   StockReservation[]
  suppliers           Supplier[]
  users               User[]
  warehouses          Warehouse[]
  WarehouseTransfer   WarehouseTransfer[]
  webhookEvents       WebhookEvent[]
  journalEntries      JournalEntry[]
  loyaltyProgram      LoyaltyProgram?
  loyaltyPoints       LoyaltyPoint[]
  notifications       Notification[]
  refunds             Refund[]
  inventoryValuations InventoryValuation[]
  reportCaches        ReportCache[]
  userBusinessRoles   UserBusinessRole[]
  subscription        Subscription?
  customRoles         CustomRole[]

  @@index([organizationId])
}

model User {
  id                   String             @id @default(cuid())
  name                 String
  email                String             @unique
  password             String?
  role                 PlatformRole       @default(USER)
  businessId           String?
  deletedAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  aiLogs               AiLog[]
  auditLogs            AuditLog[]
  orders               Order[]
  refreshTokens        RefreshToken[]
  reviews              Review[]
  notifications        Notification[]
  postedJournalEntries JournalEntry[]     @relation("JournalPostedBy")
  business             Business?          @relation(fields: [businessId], references: [id])
  businessRoles        UserBusinessRole[]
  customRoles          UserCustomRole[]

  @@index([businessId])
}

model RefreshToken {
  id         String    @id @default(cuid())
  token      String    @unique // Hashed version (SHA-256)
  familyId   String? // For grouping related tokens in a rotation lineage
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  replacedBy String? // For token rotation tracking
}

model Category {
  id         String     @id @default(uuid())
  businessId String
  name       String
  parentId   String?
  business   Business   @relation(fields: [businessId], references: [id])
  parent     Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryHierarchy")
  items      Item[]

  @@index([businessId])
}

model Brand {
  id         String   @id @default(uuid())
  businessId String
  name       String
  business   Business @relation(fields: [businessId], references: [id])
  items      Item[]

  @@index([businessId])
}

model Item {
  id                     String                   @id @default(cuid())
  businessId             String
  categoryId             String?
  brandId                String?
  title                  String
  description            String?
  sku                    String?
  barcode                String?
  price                  Decimal                  @db.Decimal(15, 2)
  costPrice              Decimal?                 @db.Decimal(15, 2)
  unit                   String                   @default("kg")
  hasBatches             Boolean                  @default(false)
  isService              Boolean                  @default(false)
  lowStockThreshold      Int                      @default(10)
  searchVector           Unsupported("tsvector")?
  deletedAt              DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  embedding              Embedding?
  inventory              Inventory[]
  brand                  Brand?                   @relation(fields: [brandId], references: [id])
  business               Business                 @relation(fields: [businessId], references: [id])
  category               Category?                @relation(fields: [categoryId], references: [id])
  orderItems             OrderItem[]
  batches                ProductBatch[]
  purchaseItems          PurchaseItem[]
  reviews                Review[]
  valuations             InventoryValuation[]
  warehouseTransferItems WarehouseTransferItem[]
  stockMovements         StockMovement[]

  @@unique([businessId, sku])
  @@index([categoryId])
  @@index([brandId])
  @@index([businessId])
  @@index([searchVector], map: "Item_search_idx", type: Gin)
}

model ProductBatch {
  id          String      @id @default(uuid())
  businessId  String
  itemId      String
  batchNumber String
  expiryDate  DateTime?
  createdAt   DateTime    @default(now())
  inventory   Inventory[]
  business    Business    @relation(fields: [businessId], references: [id])
  item        Item        @relation(fields: [itemId], references: [id])

  @@unique([itemId, batchNumber])
  @@index([businessId])
}

model Warehouse {
  id            String              @id @default(uuid())
  businessId    String
  name          String
  location      String?
  isDefault     Boolean             @default(false)
  inventory     Inventory[]
  business      Business            @relation(fields: [businessId], references: [id])
  transfersTo   WarehouseTransfer[] @relation("TransferDest")
  transfersFrom WarehouseTransfer[] @relation("TransferSource")

  @@index([businessId])
}

model Inventory {
  id             String             @id @default(uuid())
  businessId     String
  itemId         String
  warehouseId    String
  batchId        String?
  availableStock Int                @default(0)
  reservedStock  Int                @default(0)
  totalStock     Int                @default(0)
  version        Int                @default(1)
  updatedAt      DateTime           @updatedAt
  batch          ProductBatch?      @relation(fields: [batchId], references: [id])
  business       Business           @relation(fields: [businessId], references: [id])
  item           Item               @relation(fields: [itemId], references: [id])
  warehouse      Warehouse          @relation(fields: [warehouseId], references: [id])
  movements      StockMovement[]
  reservations   StockReservation[]

  @@unique([warehouseId, itemId, batchId])
  @@index([businessId, itemId])
}

model StockMovement {
  id          String       @id @default(uuid())
  businessId  String
  inventoryId String
  itemId      String? // Optional but helpful for quick item-level queries
  type        MovementType
  quantity    Int
  unitCost    Decimal?     @db.Decimal(15, 2) // Storing cost at time of movement
  reference   String?
  reason      String?
  createdAt   DateTime     @default(now())
  business    Business     @relation(fields: [businessId], references: [id])
  inventory   Inventory    @relation(fields: [inventoryId], references: [id])
  item        Item?        @relation(fields: [itemId], references: [id])

  @@index([businessId])
  @@index([inventoryId])
  @@index([itemId])
}

model InventoryValuation {
  id            String   @id @default(uuid())
  businessId    String
  itemId        String
  valuationDate DateTime @default(now())
  quantity      Float
  unitCost      Decimal  @db.Decimal(18, 2)
  totalValue    Decimal  @db.Decimal(18, 2)
  method        String   @default("WAC") // Weighted Average Cost
  reference     String? // Reference to purchase/adjustment
  item          Item     @relation(fields: [itemId], references: [id])
  business      Business @relation(fields: [businessId], references: [id])

  @@index([businessId, itemId])
  @@index([valuationDate])
}

model WarehouseTransfer {
  id            String                  @id @default(uuid())
  businessId    String
  sourceId      String
  destinationId String
  status        String                  @default("PENDING")
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  items         WarehouseTransferItem[]
  business      Business                @relation(fields: [businessId], references: [id])
  destination   Warehouse               @relation("TransferDest", fields: [destinationId], references: [id])
  source        Warehouse               @relation("TransferSource", fields: [sourceId], references: [id])

  @@index([businessId])
}

model WarehouseTransferItem {
  id         String            @id @default(uuid())
  transferId String
  itemId     String
  batchId    String?
  quantity   Int
  transfer   WarehouseTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item       Item              @relation(fields: [itemId], references: [id])

  @@index([transferId])
}

model StockReservation {
  id          String    @id @default(uuid())
  businessId  String
  inventoryId String
  orderId     String
  quantity    Int
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  business    Business  @relation(fields: [businessId], references: [id])
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  order       Order     @relation(fields: [orderId], references: [id])

  @@index([businessId])
  @@index([inventoryId])
  @@index([orderId])
}

model Customer {
  id                  String                   @id @default(uuid())
  businessId          String
  name                String
  email               String?
  phone               String?
  address             String?
  loyaltyPoints       Int                      @default(0)
  searchVector        Unsupported("tsvector")?
  deletedAt           DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  business            Business                 @relation(fields: [businessId], references: [id])
  invoices            Invoice[]
  orders              Order[]
  loyaltyPointEntries LoyaltyPoint[]

  @@index([businessId])
  @@index([searchVector], map: "Customer_search_idx", type: Gin)
}

model Order {
  id             String             @id @default(cuid())
  businessId     String
  customerId     String?
  userId         String?
  status         OrderStatus        @default(PENDING)
  paymentStatus  PaymentStatus      @default(PENDING)
  idempotencyKey String?            @unique
  total          Decimal            @db.Decimal(15, 2)
  taxAmount      Decimal            @default(0) @db.Decimal(15, 2)
  discount       Decimal            @default(0) @db.Decimal(15, 2)
  pointsRedeemed Int                @default(0)
  pointsEarned   Int                @default(0)
  deletedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  invoice        Invoice?
  business       Business           @relation(fields: [businessId], references: [id])
  customer       Customer?          @relation(fields: [customerId], references: [id])
  user           User?              @relation(fields: [userId], references: [id])
  items          OrderItem[]
  payments       Payment[]
  reservations   StockReservation[]

  @@index([businessId])
  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id         String   @id @default(cuid())
  businessId String
  orderId    String
  itemId     String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(15, 2)
  discount   Decimal  @default(0) @db.Decimal(15, 2)
  tax        Decimal  @default(0) @db.Decimal(15, 2)
  business   Business @relation(fields: [businessId], references: [id])
  item       Item     @relation(fields: [itemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([itemId])
  @@index([businessId])
}

model Supplier {
  id         String          @id @default(uuid())
  businessId String
  name       String
  contact    String?
  email      String?
  phone      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  purchases  PurchaseOrder[]
  business   Business        @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

model PurchaseOrder {
  id         String         @id @default(uuid())
  businessId String
  supplierId String
  status     PurchaseStatus @default(PENDING)
  total      Decimal        @db.Decimal(15, 2)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  items      PurchaseItem[]
  business   Business       @relation(fields: [businessId], references: [id])
  supplier   Supplier       @relation(fields: [supplierId], references: [id])

  @@index([businessId])
  @@index([supplierId])
}

model PurchaseItem {
  id              String        @id @default(uuid())
  businessId      String
  purchaseOrderId String
  itemId          String
  quantity        Int
  unitCost        Decimal       @db.Decimal(15, 2)
  business        Business      @relation(fields: [businessId], references: [id])
  item            Item          @relation(fields: [itemId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([businessId])
}

model Account {
  id           String        @id @default(uuid())
  businessId   String
  name         String
  type         AccountType
  code         String?
  systemType   String?
  balance      Decimal       @default(0) @db.Decimal(15, 2)
  business     Business      @relation(fields: [businessId], references: [id])
  journalLines JournalLine[]

  @@unique([businessId, code])
  @@unique([systemType, businessId])
  @@index([businessId, systemType])
  @@index([businessId])
}

model Notification {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  type       String
  title      String
  message    String
  metadata   Json?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([businessId])
}

model Invoice {
  id            String                   @id @default(uuid())
  businessId    String
  customerId    String?
  orderId       String                   @unique
  invoiceNumber String                   @unique
  totalAmount   Decimal                  @db.Decimal(15, 2)
  paidAmount    Decimal                  @default(0) @db.Decimal(15, 2)
  dueAmount     Decimal                  @db.Decimal(15, 2)
  dueDate       DateTime?
  searchVector  Unsupported("tsvector")?
  deletedAt     DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  business      Business                 @relation(fields: [businessId], references: [id])
  customer      Customer?                @relation(fields: [customerId], references: [id])
  order         Order                    @relation(fields: [orderId], references: [id])

  @@index([businessId])
  @@index([searchVector], map: "Invoice_search_idx", type: Gin)
}

model Payment {
  id             String        @id @default(uuid())
  businessId     String
  orderId        String
  amount         Decimal       @db.Decimal(15, 2)
  method         String
  status         PaymentStatus @default(PENDING)
  transactionId  String?
  idempotencyKey String?       @unique
  createdAt      DateTime      @default(now())
  business       Business      @relation(fields: [businessId], references: [id])
  order          Order         @relation(fields: [orderId], references: [id])
  refunds        Refund[]

  @@index([businessId])
  @@index([orderId])
}

model Refund {
  id         String   @id @default(uuid())
  businessId String
  paymentId  String
  amount     Decimal  @db.Decimal(15, 2)
  reason     String?
  status     String   @default("COMPLETED")
  createdAt  DateTime @default(now())
  payment    Payment  @relation(fields: [paymentId], references: [id])
  business   Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@index([paymentId])
}

model AuditLog {
  id            String   @id @default(uuid())
  businessId    String
  userId        String?
  action        String
  entityType    String
  entityId      String
  previousData  Json?
  newData       Json?
  changedFields Json?
  ipAddress     String?
  userAgent     String?
  requestId     String?
  createdAt     DateTime @default(now())
  business      Business @relation(fields: [businessId], references: [id])
  user          User?    @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([entityType, entityId])
}

model AiLog {
  id          String   @id @default(cuid())
  businessId  String
  userId      String?
  type        String
  prompt      String
  response    String?
  contextData Json?
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])

  @@index([businessId])
}

model OutboxEvent {
  id            String           @id @default(uuid())
  businessId    String
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        ProcessingStatus @default(PENDING)
  attempts      Int              @default(0)
  lastError     String?
  nextAttemptAt DateTime?
  lockedAt      DateTime?
  lockId        String?
  processedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt
  business      Business         @relation(fields: [businessId], references: [id])

  @@index([businessId])
  // Partial index managed manually in migration 20260516105900_optimize_outbox_index
  // @@index([status, attempts, nextAttemptAt, createdAt], map: "idx_outbox_pending")
  // WHERE status = 'PENDING' OR status = 'FAILED'
  @@index([createdAt])
}

model Embedding {
  id         String   @id @default(cuid())
  itemId     String   @unique
  vector     Json
  text       String
  createdAt  DateTime @default(now())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  item       Item     @relation(fields: [itemId], references: [id])

  @@index([businessId])
  @@index([createdAt])
}

model Review {
  id         String   @id @default(cuid())
  businessId String
  rating     Int
  comment    String?
  userId     String
  itemId     String
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])
  item       Item     @relation(fields: [itemId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, itemId])
  @@index([businessId])
}

enum Role {
  USER
  ADMIN
  MANAGER
  CASHIER
  ACCOUNTANT
  WAREHOUSE_KEEPER
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  description     String?
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String       @id @default(cuid())
  businessRole BusinessRole
  permissionId String

  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([businessRole, permissionId])
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum BusinessRole {
  OWNER
  MANAGER
  STAFF
}

model UserBusinessRole {
  id         String       @id @default(cuid())
  userId     String
  businessId String
  role       BusinessRole
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@unique([userId, businessId])
  @@index([businessId])
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PurchaseStatus {
  PENDING
  ORDERED
  RECEIVED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  COMPLETED
  FAILED
  REFUNDED
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
  RETURN
}

enum JournalStatus {
  DRAFT
  POSTED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model LoyaltyProgram {
  id                      String   @id @default(uuid())
  businessId              String   @unique
  pointsPerUnit           Decimal  @default(0.01) @db.Decimal(10, 4)
  redemptionValuePerPoint Decimal  @default(1.00) @db.Decimal(10, 4)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  business                Business @relation(fields: [businessId], references: [id])
}

model LoyaltyPoint {
  id         String    @id @default(uuid())
  businessId String
  customerId String
  points     Int
  reason     String?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  business   Business  @relation(fields: [businessId], references: [id])
  customer   Customer  @relation(fields: [customerId], references: [id])

  @@index([businessId])
  @@index([customerId])
}

model WebhookEvent {
  id            String           @id @default(cuid())
  businessId    String?
  provider      String // e.g., 'stripe', 'sslcommerz'
  externalId    String?          @unique // e.g., stripe event id for idempotency
  payload       Json
  status        ProcessingStatus @default(PENDING)
  attempts      Int              @default(0)
  lastError     String?
  nextAttemptAt DateTime?
  processingAt  DateTime?
  processedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  business      Business?        @relation(fields: [businessId], references: [id])
  // Partial index managed manually in migration 20260516105900_optimize_outbox_index
  // @@index([status], map: "idx_webhook_pending")
  // WHERE status = 'PENDING' OR status = 'FAILED'

  @@index([businessId])
  @@index([provider, externalId])
}

model JournalEntry {
  id             String        @id @default(cuid())
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id])
  date           DateTime      @default(now())
  description    String
  reference      String? // Order ID, Purchase ID, etc.
  source         String // SALES, PURCHASE, INVENTORY_ADJUSTMENT, PAYMENT
  isBalanced     Boolean       @default(false)
  status         JournalStatus @default(DRAFT)
  postedAt       DateTime?
  postedById     String?
  postedBy       User?         @relation("JournalPostedBy", fields: [postedById], references: [id])
  eventId        String?       @unique // Source event ID (Outbox/Domain Event)
  idempotencyKey String?       @unique // External system idempotency key
  lines          JournalLine[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([businessId, date])
  @@index([reference])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Decimal      @default(0) @db.Decimal(15, 2)
  credit         Decimal      @default(0) @db.Decimal(15, 2)
  description    String?
  createdAt      DateTime     @default(now())

  @@index([accountId])
  @@index([journalEntryId])
}

model ReconciliationLog {
  id         String   @id @default(uuid())
  businessId String? // Null if it's a global system check
  runDate    DateTime @default(now())
  status     String // PASS, FAIL, WARNING
  summary    String
  results    Json // Detailed IntegrityCheckResult[]
  isSystem   Boolean  @default(false)

  @@index([businessId])
  @@index([runDate])
}

model ReportCache {
  id         String   @id @default(uuid())
  businessId String
  reportType String // e.g., 'TRIAL_BALANCE', 'PROFIT_LOSS'
  parameters Json // Filter parameters
  data       Json // Cached report data
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id])

  @@index([businessId, reportType])
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
}

model SubscriptionPlan {
  id            String         @id @default(uuid())
  code          String         @unique
  name          String
  isTrial       Boolean        @default(false)
  maxUsers      Int?
  maxProducts   Int?
  maxWarehouses Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  features      PlanFeature[]
  subscriptions Subscription[]
}

model PlanFeature {
  id         String           @id @default(cuid())
  planId     String
  featureKey String
  value      String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  plan       SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
}

model Subscription {
  id          String              @id @default(uuid())
  businessId  String              @unique
  planId      String
  status      SubscriptionStatus  @default(TRIAL)
  startsAt    DateTime            @default(now())
  trialEndsAt DateTime?
  expiresAt   DateTime
  graceEndsAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  business    Business            @relation(fields: [businessId], references: [id])
  plan        SubscriptionPlan    @relation(fields: [planId], references: [id])
  events      SubscriptionEvent[]
}

model UsageMetric {
  id         String    @id @default(cuid())
  businessId String
  metricKey  String
  value      Int       @default(0)
  limit      Int?
  resetAt    DateTime?
  updatedAt  DateTime  @updatedAt

  @@unique([businessId, metricKey])
}

model SubscriptionEvent {
  id             String       @id @default(cuid())
  subscriptionId String
  eventType      String
  payload        Json?
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model CustomRole {
  id          String           @id @default(cuid())
  businessId  String
  name        String
  description String?
  permissions String[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  business    Business         @relation(fields: [businessId], references: [id])
  userRoles   UserCustomRole[]

  @@unique([businessId, name])
}

model UserCustomRole {
  id           String     @id @default(cuid())
  userId       String
  customRoleId String
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id])
  customRole   CustomRole @relation(fields: [customRoleId], references: [id])

  @@unique([userId, customRoleId])
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id         String     @id @default(uuid())
  name       String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  businesses Business[]
}

model Business {
  id                String              @id @default(uuid())
  organizationId    String
  name              String
  email             String?
  phone             String?
  address           String?
  website           String?
  logo              String?
  taxNumber         String?
  currency          String              @default("BDT")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  accounts          Account[]
  AiLog             AiLog[]
  auditLogs         AuditLog[]
  brands            Brand[]
  organization      Organization        @relation(fields: [organizationId], references: [id])
  categories        Category[]
  customers         Customer[]
  embeddings        Embedding[]
  inventory         Inventory[]
  invoices          Invoice[]
  products          Item[]
  ledgerEntries     LedgerEntry[]
  orders            Order[]
  OrderItem         OrderItem[]
  outboxEvents      OutboxEvent[]
  payments          Payment[]
  ProductBatch      ProductBatch[]
  PurchaseItem      PurchaseItem[]
  purchases         PurchaseOrder[]
  Review            Review[]
  stockMovements    StockMovement[]
  stockReservations StockReservation[]
  suppliers         Supplier[]
  users             User[]
  warehouses        Warehouse[]
  WarehouseTransfer WarehouseTransfer[]
  webhookEvents     WebhookEvent[]
  loyaltyProgram    LoyaltyProgram?
  loyaltyPoints     LoyaltyPoint[]

  @@index([organizationId])
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  password      String?
  role          Role          @default(USER)
  businessId    String?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  aiLogs        AiLog[]
  auditLogs     AuditLog[]
  ledgerEntries LedgerEntry[]
  orders        Order[]
  reviews       Review[]
  business      Business?     @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

model Category {
  id         String     @id @default(uuid())
  businessId String
  name       String
  parentId   String?
  business   Business   @relation(fields: [businessId], references: [id])
  parent     Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryHierarchy")
  items      Item[]

  @@index([businessId])
}

model Brand {
  id         String   @id @default(uuid())
  businessId String
  name       String
  business   Business @relation(fields: [businessId], references: [id])
  items      Item[]

  @@index([businessId])
}

model Item {
  id            String                   @id @default(cuid())
  businessId    String
  categoryId    String?
  brandId       String?
  title         String
  description   String?
  sku           String?
  barcode       String?
  price         Decimal                  @db.Decimal(15, 2)
  costPrice     Decimal?                 @db.Decimal(15, 2)
  unit          String                   @default("kg")
  hasBatches    Boolean                  @default(false)
  isService     Boolean                  @default(false)
  searchVector  Unsupported("tsvector")?
  deletedAt     DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  embedding     Embedding?
  inventory     Inventory[]
  brand         Brand?                   @relation(fields: [brandId], references: [id])
  business      Business                 @relation(fields: [businessId], references: [id])
  category      Category?                @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  batches       ProductBatch[]
  purchaseItems PurchaseItem[]
  reviews       Review[]

  @@unique([businessId, sku])
  @@index([categoryId])
  @@index([brandId])
  @@index([businessId])
  @@index([searchVector], map: "Item_search_idx", type: Gin)
}

model ProductBatch {
  id          String      @id @default(uuid())
  businessId  String
  itemId      String
  batchNumber String
  expiryDate  DateTime?
  createdAt   DateTime    @default(now())
  inventory   Inventory[]
  business    Business    @relation(fields: [businessId], references: [id])
  item        Item        @relation(fields: [itemId], references: [id])

  @@unique([itemId, batchNumber])
  @@index([businessId])
}

model Warehouse {
  id            String              @id @default(uuid())
  businessId    String
  name          String
  location      String?
  inventory     Inventory[]
  business      Business            @relation(fields: [businessId], references: [id])
  transfersTo   WarehouseTransfer[] @relation("TransferDest")
  transfersFrom WarehouseTransfer[] @relation("TransferSource")

  @@index([businessId])
}

model Inventory {
  id             String             @id @default(uuid())
  businessId     String
  itemId         String
  warehouseId    String
  batchId        String?
  availableStock Int                @default(0)
  reservedStock  Int                @default(0)
  totalStock     Int                @default(0)
  version        Int                @default(1)
  updatedAt      DateTime           @updatedAt
  batch          ProductBatch?      @relation(fields: [batchId], references: [id])
  business       Business           @relation(fields: [businessId], references: [id])
  item           Item               @relation(fields: [itemId], references: [id])
  warehouse      Warehouse          @relation(fields: [warehouseId], references: [id])
  movements      StockMovement[]
  reservations   StockReservation[]

  @@unique([warehouseId, itemId, batchId])
  @@index([businessId, itemId])
}

model StockMovement {
  id          String       @id @default(uuid())
  businessId  String
  inventoryId String
  type        MovementType
  quantity    Int
  reference   String?
  reason      String?
  createdAt   DateTime     @default(now())
  business    Business     @relation(fields: [businessId], references: [id])
  inventory   Inventory    @relation(fields: [inventoryId], references: [id])

  @@index([businessId])
  @@index([inventoryId])
}

model WarehouseTransfer {
  id            String    @id @default(uuid())
  businessId    String
  sourceId      String
  destinationId String
  status        String    @default("PENDING")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  business      Business  @relation(fields: [businessId], references: [id])
  destination   Warehouse @relation("TransferDest", fields: [destinationId], references: [id])
  source        Warehouse @relation("TransferSource", fields: [sourceId], references: [id])

  @@index([businessId])
}

model StockReservation {
  id          String    @id @default(uuid())
  businessId  String
  inventoryId String
  orderId     String
  quantity    Int
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  business    Business  @relation(fields: [businessId], references: [id])
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  order       Order     @relation(fields: [orderId], references: [id])

  @@index([businessId])
  @@index([inventoryId])
  @@index([orderId])
}

model Customer {
  id                  String                   @id @default(uuid())
  businessId          String
  name                String
  email               String?
  phone               String?
  address             String?
  loyaltyPoints       Int                      @default(0)
  searchVector        Unsupported("tsvector")?
  deletedAt           DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  business            Business                 @relation(fields: [businessId], references: [id])
  invoices            Invoice[]
  orders              Order[]
  loyaltyPointEntries LoyaltyPoint[]

  @@index([businessId])
  @@index([searchVector], map: "Customer_search_idx", type: Gin)
}

model Order {
  id             String             @id @default(cuid())
  businessId     String
  customerId     String?
  userId         String?
  status         OrderStatus        @default(PENDING)
  paymentStatus  PaymentStatus      @default(PENDING)
  idempotencyKey String?            @unique
  total          Decimal            @db.Decimal(15, 2)
  taxAmount      Decimal            @default(0) @db.Decimal(15, 2)
  discount       Decimal            @default(0) @db.Decimal(15, 2)
  deletedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  invoice        Invoice?
  business       Business           @relation(fields: [businessId], references: [id])
  customer       Customer?          @relation(fields: [customerId], references: [id])
  user           User?              @relation(fields: [userId], references: [id])
  items          OrderItem[]
  payments       Payment[]
  reservations   StockReservation[]

  @@index([businessId])
  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id         String   @id @default(cuid())
  businessId String
  orderId    String
  itemId     String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(15, 2)
  discount   Decimal  @default(0) @db.Decimal(15, 2)
  tax        Decimal  @default(0) @db.Decimal(15, 2)
  business   Business @relation(fields: [businessId], references: [id])
  item       Item     @relation(fields: [itemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([itemId])
  @@index([businessId])
}

model Supplier {
  id         String          @id @default(uuid())
  businessId String
  name       String
  contact    String?
  email      String?
  phone      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  purchases  PurchaseOrder[]
  business   Business        @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

model PurchaseOrder {
  id         String         @id @default(uuid())
  businessId String
  supplierId String
  status     PurchaseStatus @default(PENDING)
  total      Decimal        @db.Decimal(15, 2)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  items      PurchaseItem[]
  business   Business       @relation(fields: [businessId], references: [id])
  supplier   Supplier       @relation(fields: [supplierId], references: [id])

  @@index([businessId])
  @@index([supplierId])
}

model PurchaseItem {
  id              String        @id @default(uuid())
  businessId      String
  purchaseOrderId String
  itemId          String
  quantity        Int
  unitCost        Decimal       @db.Decimal(15, 2)
  business        Business      @relation(fields: [businessId], references: [id])
  item            Item          @relation(fields: [itemId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([businessId])
}

model Account {
  id            String        @id @default(uuid())
  businessId    String
  name          String
  type          AccountType
  code          String?
  balance       Decimal       @default(0) @db.Decimal(15, 2)
  business      Business      @relation(fields: [businessId], references: [id])
  ledgerEntries LedgerEntry[]

  @@unique([businessId, code])
  @@index([businessId])
}

model LedgerEntry {
  id          String   @id @default(uuid())
  businessId  String
  accountId   String
  userId      String?
  debit       Decimal  @default(0) @db.Decimal(15, 2)
  credit      Decimal  @default(0) @db.Decimal(15, 2)
  description String?
  reference   String?
  createdAt   DateTime @default(now())
  account     Account  @relation(fields: [accountId], references: [id])
  business    Business @relation(fields: [businessId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([accountId])
}

model Invoice {
  id            String                   @id @default(uuid())
  businessId    String
  customerId    String?
  orderId       String                   @unique
  invoiceNumber String                   @unique
  totalAmount   Decimal                  @db.Decimal(15, 2)
  paidAmount    Decimal                  @default(0) @db.Decimal(15, 2)
  dueAmount     Decimal                  @db.Decimal(15, 2)
  dueDate       DateTime?
  searchVector  Unsupported("tsvector")?
  deletedAt     DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  business      Business                 @relation(fields: [businessId], references: [id])
  customer      Customer?                @relation(fields: [customerId], references: [id])
  order         Order                    @relation(fields: [orderId], references: [id])

  @@index([businessId])
  @@index([searchVector], map: "Invoice_search_idx", type: Gin)
}

model Payment {
  id             String        @id @default(uuid())
  businessId     String
  orderId        String
  amount         Decimal       @db.Decimal(15, 2)
  method         String
  status         PaymentStatus @default(PENDING)
  transactionId  String?
  idempotencyKey String?       @unique
  createdAt      DateTime      @default(now())
  business       Business      @relation(fields: [businessId], references: [id])
  order          Order         @relation(fields: [orderId], references: [id])

  @@index([businessId])
  @@index([orderId])
}

model AuditLog {
  id            String   @id @default(uuid())
  businessId    String
  userId        String?
  action        String
  entityType    String
  entityId      String
  previousData  Json?
  newData       Json?
  changedFields Json?
  createdAt     DateTime @default(now())
  business      Business @relation(fields: [businessId], references: [id])
  user          User?    @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([entityType, entityId])
}

model AiLog {
  id          String   @id @default(cuid())
  businessId  String
  userId      String?
  type        String
  prompt      String
  response    String?
  contextData Json?
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])

  @@index([businessId])
}

model WebhookEvent {
  id               String           @id @default(uuid())
  businessId       String
  gateway          String
  eventType        String
  payload          Json
  processingStatus ProcessingStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  business         Business         @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

model OutboxEvent {
  id            String   @id @default(uuid())
  businessId    String
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  isProcessed   Boolean  @default(false)
  createdAt     DateTime @default(now())
  business      Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

model Embedding {
  id         String   @id @default(cuid())
  itemId     String   @unique
  vector     Json
  text       String
  createdAt  DateTime @default(now())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  item       Item     @relation(fields: [itemId], references: [id])

  @@index([businessId])
}

model Review {
  id         String   @id @default(cuid())
  businessId String
  rating     Int
  comment    String?
  userId     String
  itemId     String
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])
  item       Item     @relation(fields: [itemId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, itemId])
  @@index([businessId])
}

enum Role {
  USER
  SELLER
  ADMIN
  MANAGER
  CASHIER
  ACCOUNTANT
  WAREHOUSE_KEEPER
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PurchaseStatus {
  PENDING
  ORDERED
  RECEIVED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  COMPLETED
  FAILED
  REFUNDED
}

enum ProcessingStatus {
  PENDING
  PROCESSED
  FAILED
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
  RETURN
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model LoyaltyProgram {
  id            String   @id @default(uuid())
  businessId    String   @unique
  pointsPerUnit Decimal  @default(0.01) @db.Decimal(10, 4)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  business      Business @relation(fields: [businessId], references: [id])
}

model LoyaltyPoint {
  id         String    @id @default(uuid())
  businessId String
  customerId String
  points     Int
  reason     String?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  business   Business  @relation(fields: [businessId], references: [id])
  customer   Customer  @relation(fields: [customerId], references: [id])

  @@index([businessId])
  @@index([customerId])
}
